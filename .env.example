# LLM API Configuration
# LLM_BACKEND selects the transport:
#   openai (default) = OpenAI-compatible /chat/completions
#   ollama           = native Ollama /api/chat
# Use LLM_BACKEND=ollama for gemma4-v4: thinking can only be disabled
# (think:false) on the native /api/chat path. On the openai path a thinking
# model exhausts its token budget thinking and returns empty content.
LLM_BACKEND=openai

# Shared across both backends.
LLM_MODEL=deepseek-chat
# Per-request timeout in seconds (also covers Ollama cold-start latency).
LLM_TIMEOUT=120

# openai backend settings.
# Example below uses DeepSeek; swap in any compatible provider.
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxx

# ollama backend settings (used only when LLM_BACKEND=ollama).
LLM_OLLAMA_BASE=http://127.0.0.1:11434
# Context window and max generated tokens for the native /api/chat options.
LLM_NUM_CTX=32768
LLM_NUM_PREDICT=4096
# Local gemma4-v4 example:
# LLM_BACKEND=ollama
# LLM_MODEL=gemma4-v4
# LLM_OLLAMA_BASE=http://127.0.0.1:11434

# OpenRouter example:
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-xxxxxxxx
# LLM_MODEL=anthropic/claude-sonnet-4

# Kimi / Moonshot example:
# LLM_API_BASE=https://api.moonshot.ai/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=kimi-k2.5
