<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>LDA</string>
  <key>CFBundleDisplayName</key><string>LDA</string>
  <key>CFBundleIdentifier</key><string>com.haotianyi.LDA</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleExecutable</key><string>LDAApp</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>fr</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
  </array>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>NSHumanReadableCopyright</key><string>Copyright © 2026 Haotian Yi (Forme Locale Studio).</string>

  <!-- The encrypted files LDA writes. The portable workspace (.ldawork)
       holds a matter's documents, review decisions, and replacements; the
       compliance report (.ldareport) holds the processing report a lawyer
       hands over. Both are declared as document types so a double-click
       reaches the app, and exported as owned types so Finder names them
       rather than calling them generic documents. All conform to public.data
       only: the contents are ciphertext, and nothing outside LDA can read
       further into them.

       The mapping sidecar (.ldamap) is declared as a RELATED ITEM type
       (NSIsRelatedItemType). Export for AI writes <base>.ldamap next to the
       .md the user chose in a save panel, and Restore reads the .ldamap next
       to the file chosen in an open panel. Under App Sandbox the Powerbox
       grant covers the chosen file only; with this declaration, and file
       coordination through a presenter naming the chosen file as primary
       (see RelatedSidecarAccess in LDAUI), the grant extends to the sidecar.
       Without it the sidecar write is denied in the packaged app. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>LDA Workspace</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.haotianyi.LDA.workspace</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>LDA Report</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.haotianyi.LDA.compliancereport</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key><string>LDA Mapping</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>NSIsRelatedItemType</key><true/>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>ldamap</string>
      </array>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.haotianyi.LDA.mapping</string>
      </array>
    </dict>
  </array>

  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>com.haotianyi.LDA.workspace</string>
      <key>UTTypeDescription</key><string>LDA Workspace</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>ldawork</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>com.haotianyi.LDA.compliancereport</string>
      <key>UTTypeDescription</key><string>LDA Report</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>ldareport</string>
        </array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key><string>com.haotianyi.LDA.mapping</string>
      <key>UTTypeDescription</key><string>LDA Mapping</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>ldamap</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
