<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>LDA</string>
  <key>CFBundleDisplayName</key><string>LDA</string>
  <key>CFBundleIdentifier</key><string>com.haotianyi.LDA</string>
  <key>CFBundleVersion</key><string>1.0</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleExecutable</key><string>LDAApp</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
  <key>NSHumanReadableCopyright</key><string>Legal Document Anonymizer. Documents stay on this Mac.</string>

  <!-- The portable workspace (.ldawork): one encrypted file holding a matter's
       documents, review decisions, and replacements. Declared as a document
       type so a double-click reaches the app, and exported as an owned type so
       Finder names it rather than calling it a generic document. It conforms to
       public.data only: the contents are ciphertext, and nothing outside LDA
       can read further into it. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key><string>LDA Workspace</string>
      <key>CFBundleTypeRole</key><string>Editor</string>
      <key>LSHandlerRank</key><string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.haotianyi.LDA.workspace</string>
      </array>
    </dict>
  </array>

  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key><string>com.haotianyi.LDA.workspace</string>
      <key>UTTypeDescription</key><string>LDA Workspace</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>ldawork</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
